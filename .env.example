# -*- coding: utf-8 -*-

# ============================================
# LLM Provider 配置 (优先使用OpenAI兼容API)
# ============================================

# 选择使用的LLM提供商: openai (默认) 或 anthropic
LLM_PROVIDER=openai

# ============================================
# OpenAI API 配置 (默认, 支持任何兼容OpenAI的API)
# ============================================

# OpenAI API 密钥
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI API 基础URL (可选)
# 默认为 https://api.openai.com/v1
# 如果使用兼容OpenAI的API(如国内服务商), 在这里设置base_url
# 示例:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# OpenAI 模型名称 (可选)
# 默认为 gpt-4o
# 如果使用其他兼容API, 根据服务商修改模型名
# 示例:
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL=deepseek-chat
# OPENAI_MODEL=qwen-max
# OPENAI_MODEL=glm-4

# ============================================
# Anthropic API 配置 (可选)
# ============================================
# 如果使用Anthropic, 需要:
# 1. 设置 LLM_PROVIDER=anthropic
# 2. 安装依赖: uv sync --extra anthropic
# 3. 配置以下环境变量

# Anthropic API 密钥
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Anthropic 模型名称 (可选)
# 默认为 claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================
# 常见兼容OpenAI的API配置示例
# ============================================

# DeepSeek (国内)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-deepseek-api-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# 阿里云通义千问
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-aliyun-api-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-max

# 智谱 GLM
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-zhipu-api-key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4
